    <worksheet name='Overdue Restock'>
      <table>
        <view>
          <datasources>
            <datasource caption='stock_behavior_fields (uk_retail.stock_behavior_fields)+ (postgres)' name='federated.1soqbz20jgxswo17gzp9b1l1c1bh' />
          </datasources>
          <datasource-dependencies datasource='federated.1soqbz20jgxswo17gzp9b1l1c1bh'>
            <column caption='Overdue Multiple' datatype='real' name='[Calculation_0236421790646273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[recency_days] / [avg_interval_fractional_day]' />
            </column>
            <column caption='Inventory Signal Category (Q174)' datatype='string' name='[Calculation_0236421793841154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [frequency_completed] &gt;= 5&#13;&#10;      AND NOT ISNULL([avg_interval_fractional_day])&#13;&#10;      AND [recency_days] &gt;= 8 * [avg_interval_fractional_day]&#13;&#10;      AND [monetary_net] &gt;= 1000&#13;&#10;   THEN &quot;Overdue Restock&quot;&#13;&#10;   ELSEIF [recency_days] &gt;= 377 AND [frequency_completed] &lt;= 3&#13;&#10;   THEN &quot;Dead Stock / Seasonal Dormant&quot;&#13;&#10;   END' />
            </column>
            <column caption='Exhibit URL (Overdue Restock)' datatype='string' name='[Calculation_0236421795381251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;overdue_restock_standalone_3d.html&quot;' />
