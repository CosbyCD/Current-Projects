      <aliases enabled='yes' />
      <column caption='Exhibit URL (Funnel Tier)' datatype='string' name='[Calculation_0564349373497344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_0943130847477760]) THEN &quot;uk_retail_rfm_3d_log.html&quot;&#13;&#10;ELSEIF [Calculation_0943130854801411] = &quot;Lapsed Whale&quot;&#13;&#10;THEN &quot;lapsed_whale_isolated_3d.html&quot;&#13;&#10;ELSEIF [Calculation_0943130854801411] = &quot;Lapsed, Typical&quot;&#13;&#10;THEN &quot;lapsed_typical_isolated_3d.html&quot;&#13;&#10;ELSE &quot;uk_retail_rfm_3d_log.html&quot;&#13;&#10;END' />
      </column>
      <column caption='Spend (Net)' datatype='real' name='[Calculation_0943130847477760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[monetary_net]' />
      </column>
      <column caption='Nov 2010 Cohort Flag' datatype='string' name='[Calculation_0943130850496513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [recency_days] &gt;= 350 AND [recency_days] &lt;= 424 THEN &quot;Nov 2010 Cohort&quot; ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Never-Converted Flag' datatype='string' name='[Calculation_0943130854371330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([frequency_completed]) AND ISNULL([monetary_gross]) THEN &quot;Never Converted&quot; ELSE &quot;Converted&quot; END' />
      </column>
      <column caption='Recency-Monetary Tier (Rev. Q105/106/122)' datatype='string' name='[Calculation_0943130854801411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_0943130847477760]) THEN &quot;Never Converted&quot;&#13;&#10;ELSEIF [recency_days] &lt;= 377 THEN &quot;Recent&quot;&#13;&#10;ELSEIF [recency_days] &gt; 377 AND ROUND([Calculation_0943130847477760], 2) &gt;= 2180.28 THEN &quot;Lapsed Whale&quot;&#13;&#10;ELSE &quot;Lapsed, Typical&quot;&#13;&#10;END' />
      </column>
      <column caption='Frequency Spike Tier (Rev. Q108/128)' datatype='string' name='[Calculation_0943130895630340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ROUND([Calculation_0943130847477760], 2) &gt;= 5224.45 THEN &quot;Top Decile (Spike Zone)&quot; ELSE &quot;Below Top Decile&quot; END' />
      </column>
