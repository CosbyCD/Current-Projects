        <zone forceUpdate='true' h='17057' id='8' type-v2='text' w='39239' x='36310' y='63542'>
          <formatted-text>
            <run bold='true' fontsize='15'>IF ROUND([Spend (Net)], 2) &gt;= 5224.45 THEN &quot;Top Decile (Spike Zone)&quot; ELSE &quot;Below Top Decile&quot; END</run>
          </formatted-text>
        </zone>
        <zone h='21875' id='9' type-v2='text' w='34993' x='21596' y='44141'>
          <formatted-text>
            <run bold='true' fontsize='15'><![CDATA[IF [Recency Days] <= 377 THEN "Recent"]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='15'>ELSEIF [Recency Days] &gt; 377 AND ROUND([Spend (Net)], 2) &gt;= 2180.28 THEN &quot;Lapsed Whale&quot;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='15'>ELSE &quot;Lapsed, Typical&quot;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='15'>END</run>
          </formatted-text>
        </zone>
        <zone h='10938' id='10' type-v2='text' w='33309' x='21816' y='30208'>
          <formatted-text>
            <run bold='true' fontsize='15'>IF ISNULL([Frequency Completed]) AND ISNULL([Monetary Gross]) THEN &quot;Never Converted&quot; ELSE &quot;Converted&quot; END</run>
          </formatted-text>
