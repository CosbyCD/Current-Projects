      <aliases enabled='yes' />
      <column caption='Bucket (Funnel Tier)' datatype='integer' name='[Calculation_0310637461385217]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_0943130847477760]) THEN 0&#13;&#10;ELSEIF [recency_days] &lt;= 377 THEN 1&#13;&#10;ELSEIF [recency_days] &gt; 377 AND ROUND([Calculation_0943130847477760], 2) &gt;= 2180.28 THEN 2&#13;&#10;ELSE 3&#13;&#10;END' />
      </column>
      <column caption='Exhibit URL (Funnel Tier)' datatype='string' name='[Calculation_0564349373497344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_0943130847477760]) THEN &quot;never_converted_colored_by_date.html&quot;&#13;&#10;ELSEIF [Calculation_0943130854801411] = &quot;Lapsed Whale&quot;&#13;&#10;THEN &quot;lapsed_whale_isolated_3d.html&quot;&#13;&#10;ELSEIF [Calculation_0943130854801411] = &quot;Lapsed, Typical&quot;&#13;&#10;THEN &quot;lapsed_typical_isolated_3d.html&quot;&#13;&#10;ELSEIF [Calculation_0943130854801411] = &quot;Recent&quot;&#13;&#10;THEN &quot;recent_isolated_3d.html&quot;&#13;&#10;ELSE &quot;uk_retail_rfm_3d_log.html&quot;&#13;&#10;END' />
      </column>
      <column caption='Calculation1[Frequency Spike Tier (Rev. Q108/128)]' datatype='string' name='[Calculation_0578644444598272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0943130895630340] = &quot;Top Decile (Spike Zone)&quot;&#13;&#10;THEN &quot;frequency_spike_tier_isolated_3d.html&quot;&#13;&#10;ELSE &quot;uk_retail_rfm_3d_log.html&quot;&#13;&#10;END' />
      </column>
      <column caption='Exhibit URL (Frequency Spike)' datatype='string' name='[Calculation_0578644448673793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0943130895630340] = &quot;Top Decile (Spike Zone)&quot;&#13;&#10;THEN &quot;frequency_spike_tier_isolated_3d.html&quot;&#13;&#10;ELSE &quot;uk_retail_rfm_3d_log.html&quot;&#13;&#10;END' />
      </column>
      <column caption='Spend (Net)' datatype='real' name='[Calculation_0943130847477760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[monetary_net]' />
      </column>
      <column caption='Nov 2010 Cohort Flag' datatype='string' name='[Calculation_0943130850496513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [recency_days] &gt;= 350 AND [recency_days] &lt;= 424 THEN &quot;Nov 2010 Cohort&quot; ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Never-Converted Flag' datatype='string' name='[Calculation_0943130854371330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([frequency_completed]) AND ISNULL([monetary_gross]) THEN &quot;Never Converted&quot; ELSE &quot;Converted&quot; END' />
      </column>
      <column caption='Recency-Monetary Tier (Rev. Q105/106/122)' datatype='string' name='[Calculation_0943130854801411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_0310637461385217]&#13;&#10;WHEN 0 THEN &quot;Never Converted&quot;&#13;&#10;WHEN 1 THEN &quot;Recent&quot;&#13;&#10;WHEN 2 THEN &quot;Lapsed Whale&quot;&#13;&#10;WHEN 3 THEN &quot;Lapsed, Typical&quot;&#13;&#10;END' />
      </column>
      <column caption='Frequency Spike Tier (Rev. Q108/128)' datatype='string' name='[Calculation_0943130895630340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ROUND([Calculation_0943130847477760], 2) &gt;= 5224.45 THEN &quot;Top Decile (Spike Zone)&quot; ELSE &quot;Below Top Decile&quot; END' />
      </column>
      <column caption='Exhibit URL (Nov 2010 Cohort — Acquisition Month, Gradient)' datatype='string' name='[Calculation_1181177827844101]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;nov_2010_cohort_acquisition_month_3d_gradient.html&quot;' />
      </column>
      <column caption='Frequency Buckets' datatype='string' name='[Calculation_1181177842696200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [frequency_completed] = 1 THEN &quot;1 order&quot;&#13;&#10;ELSEIF [frequency_completed] &gt;= 2 AND [frequency_completed] &lt;= 5 THEN &quot;2-5 orders&quot;&#13;&#10;ELSEIF [frequency_completed] &gt;= 6 AND [frequency_completed] &lt;= 15 THEN &quot;6-15 orders&quot;&#13;&#10;ELSE &quot;16+ orders&quot;&#13;&#10;END' />
      </column>
      <column caption='Acquisition Month Bucket' datatype='string' name='[Calculation_1181177844015114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [first_purchase_date] &lt; #2010-10-01# THEN &quot;Pre-Oct 2010&quot;&#13;&#10;ELSEIF [first_purchase_date] &gt;= #2010-10-01# AND [first_purchase_date] &lt; #2010-11-01# THEN &quot;Oct 2010&quot;&#13;&#10;ELSEIF [first_purchase_date] &gt;= #2010-11-01# AND [first_purchase_date] &lt; #2010-12-01# THEN &quot;Nov 2010&quot;&#13;&#10;ELSE &quot;Dec 2010&quot;&#13;&#10;END' />
      </column>
      <column caption='Last-Order Month Bucket' datatype='string' name='[Calculation_1181177844736011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [last_order_date]) = #2010-10-01# THEN &quot;Oct 2010&quot;&#13;&#10;ELSEIF DATETRUNC(&apos;month&apos;, [last_order_date]) = #2010-11-01# THEN &quot;Nov 2010&quot;&#13;&#10;ELSE &quot;Dec 2010&quot;&#13;&#10;END' />
      </column>
      <column caption='Acquisition Month Gradient' datatype='datetime' name='[Calculation_1181177892630540]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_purchase_date])' />
      </column>
      <column caption='Exhibit URL (Nov 2010 Cohort — Acquisition Month, Bucketed)' datatype='string' name='[Calculation_1181177894744077]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;nov_2010_cohort_acquisition_month_3d.html&quot;' />
      </column>
